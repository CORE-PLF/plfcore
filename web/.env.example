# ===== RESYNC — variáveis de ambiente =====
# Copie para .env e preencha. NUNCA commite o .env.

# URL pública do site (usada para gerar links absolutos; atrás do proxy do Coolify)
APP_URL=https://resync.exemplo.com
PORT=3000
NODE_ENV=production

# MySQL/MariaDB criado no Coolify — use o hostname INTERNO do serviço, não localhost
DATABASE_URL=mysql://usuario:senha@mysql-host:3306/resync

# RESERVADA — não usada na v1 (rate limit e fila persistem no MySQL). Deixe vazia.
REDIS_URL=

# Segredo de sessão (>= 32 chars aleatórios): openssl rand -base64 32
AUTH_SECRET=

# Chave de criptografia de dados sensíveis (EXATAMENTE 32 bytes): openssl rand -base64 24
ENCRYPTION_KEY=

# Pagamentos: "sandbox" (testes) ou "mercadopago"
PAYMENT_PROVIDER=sandbox
# Segredo para validar assinatura dos webhooks do provedor
PAYMENT_WEBHOOK_SECRET=
# Mercado Pago (obrigatório se PAYMENT_PROVIDER=mercadopago)
MERCADOPAGO_ACCESS_TOKEN=
# Opcional: ID da conta recebedora — webhook confere que o pagamento é dela
MERCADOPAGO_COLLECTOR_ID=

# Instalador — diretório do volume persistente onde o .exe fica gravado.
# Ele NUNCA é servido por URL pública: quem entrega é /download/arquivo, que
# reconfere sessão + licença (ou token assinado de 10 min, para o aplicativo).
INSTALLERS_DIR=/data/installers

# Discord — https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Public key da aba "General Information" (verificação das interactions HTTP)
DISCORD_PUBLIC_KEY=

# E-mail transacional (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Resync <no-reply@resync.exemplo.com>
